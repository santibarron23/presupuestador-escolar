# Copiar a .env (o cargar en Render → Environment). Ver docs/ARQUITECTURA.md.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_FALLBACK_MODEL=claude-sonnet-5-5
AI_EFFORT=low
AI_TIMEOUT_MS=60000
AI_RERANK_MAX_ITEMS=15
ALLOWED_ORIGINS=https://librerialerma.com.ar,https://www.librerialerma.com.ar,https://presupuestador-escolar.onrender.com
RATE_LIMIT_PER_10MIN=15
# Opcional: API oficial de Tiendanube para el sync del catálogo
TIENDANUBE_STORE_ID=854738
TIENDANUBE_ACCESS_TOKEN=
# Fase 3: datos (todo opcional)
DATABASE_URL=
DATABASE_SSL_NO_VERIFY=
ADMIN_TOKEN=
BUDGET_SHARE_DAYS=90
# Con el snippet de Tiendanube instalado: https://www.librerialerma.com.ar/presupuesta-tu-lista-escolar/?p=
SHARE_BASE_URL=
